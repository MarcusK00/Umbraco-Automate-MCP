{
  "name": "@umbraco-automate/mcp-dev",
  "version": "18.0.0-beta.4",
  "type": "module",
  "description": "MCP server for automate",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./collections": "./dist/collections.js",
    "./tool-types": {
      "types": "./dist/tool-types.d.ts"
    }
  },
  "bin": {
    "automate-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup --config tsup.config.ts",
    "postbuild": "umbraco-mcp-generate-types",
    "compile": "tsc --noEmit",
    "watch": "tsup --config tsup.config.ts --watch",
    "generate": "orval --config orval.config.ts",
    "start:umbraco": "bash scripts/start-umbraco.sh",
    "create-api-user": "node scripts/create-api-user.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:rerun-failures": "node scripts/rerun-failures.mjs",
    "test:changed": "node scripts/test-changed.mjs",
    "test:evals": "npm run build && node scripts/run-evals-isolated.mjs",
    "test:all": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=__tests__ --runInBand --forceExit && node scripts/run-evals-isolated.mjs",
    "test:e2e": "npx playwright test --config tests/hosted-e2e/playwright.config.ts",
    "dev:worker": "npx wrangler dev",
    "deploy:worker": "npx wrangler deploy"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "Umbraco",
    "MCP",
    "Model Context Protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.191",
    "@cloudflare/workers-oauth-provider": "^0.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@umbraco-cms/mcp-hosted": "1.0.0-beta.47",
    "@umbraco-cms/mcp-server-sdk": "1.0.0-beta.47",
    "agents": "^0.6.0",
    "dotenv": "^17.4.2",
    "yargs": "^18.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@jest/types": "^29.6.3",
    "@playwright/test": "^1.61.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/yargs": "^17.0.33",
    "jest": "^30.4.2",
    "orval": "^8.19.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "undici": "^8.9.0",
    "wrangler": "^4.104.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "core-js-pure@3.50.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "msw@2.15.0": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260907.1": true,
    "fsevents@2.3.3": true
  }
}
